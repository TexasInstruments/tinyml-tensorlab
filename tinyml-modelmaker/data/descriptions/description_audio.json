    "MSPM0G5187":{
      "audio_classification":{
        "default_preset":{
          "compilation":{
            "target":"c, ti-npu skip_normalize=true output_int=true",
            "target_c_mcpu":"cortex-m0plus",
            "cross_compiler":"/opt/tinyml/tinyml-mlbackend/tinyml_proprietary_models/tiarmclang",
            "cross_compiler_options":"-Os -mcpu=cortex-m0plus -march=thumbv6m -mtune=cortex-m0plus -mthumb -mfloat-abi=soft -I. -Wno-return-type"
          }
        },
        "forced_soft_npu_preset":{
          "compilation":{
            "target":"c, ti-npu type=soft skip_normalize=true output_int=true",
            "target_c_mcpu":"cortex-m0plus",
            "cross_compiler":"/opt/tinyml/tinyml-mlbackend/tinyml_proprietary_models/tiarmclang",
            "cross_compiler_options":"-Os -mcpu=cortex-m0plus -march=thumbv6m -mtune=cortex-m0plus -mthumb -mfloat-abi=soft -I. -Wno-return-type"
          }
        },
        "compress_npu_layer_data":{
          "compilation":{
            "target":"c, ti-npu skip_normalize=true output_int=true opt_for_space=true",
            "target_c_mcpu":"cortex-m0plus",
